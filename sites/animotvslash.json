{
  "name": "animotvslash",
  "baseUrl": "https://animotvslash.org",
  "operations": [
    {
      "name": "search",
      "description": "Live anime search via the site search overlay (POST admin-ajax ts_ac_do_search)",
      "request": {
        "method": "POST",
        "url": "https://animotvslash.org/wp-admin/admin-ajax.php",
        "headers": {
          "accept": "text/plain, */*; q=0.01",
          "accept-language": "en-US,en;q=0.9",
          "content-type": "application/x-www-form-urlencoded; charset=UTF-8",
          "origin": "https://animotvslash.org",
          "priority": "u=1, i",
          "referer": "https://animotvslash.org/",
          "sec-ch-ua": "\"Google Chrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\"",
          "sec-ch-ua-mobile": "?0",
          "sec-ch-ua-platform": "\"Linux\"",
          "sec-fetch-dest": "empty",
          "sec-fetch-mode": "cors",
          "sec-fetch-site": "same-origin",
          "user-agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/153.0.0.0 Safari/537.36",
          "x-requested-with": "XMLHttpRequest"
        },
        "body": "action=ts_ac_do_search&ts_ac_query=%7Bq%7D"
      },
      "slots": [
        {
          "param": "q",
          "at": [
            "form:ts_ac_query"
          ]
        }
      ],
      "volatile": [],
      "trigger": {
        "url": "https://animotvslash.org/",
        "steps": [
          {
            "action": "press",
            "value": "s"
          },
          {
            "action": "wait",
            "ms": 600
          },
          {
            "action": "fill",
            "selector": "#as-so-input",
            "value": "{q}"
          },
          {
            "action": "wait",
            "ms": 2500
          }
        ]
      },
      "match": {
        "method": "POST",
        "host": "animotvslash.org",
        "path": "/wp-admin/admin-ajax.php"
      },
      "response": {
        "format": "json",
        "contentType": "text/html; charset=UTF-8",
        "extract": "anime[*].all",
        "pick": [
          "id=ID",
          "title=post_title",
          "url=post_link",
          "image=post_image",
          "genres=post_genres",
          "type=post_type",
          "latest=post_latest",
          "lang=post_sub"
        ]
      },
      "params": [
        {
          "name": "q",
          "type": "string",
          "required": true,
          "example": "one piece"
        }
      ],
      "readOnly": true,
      "minTier": 1,
      "learnedLoggedIn": false
    },
    {
      "name": "series",
      "description": "All episodes of an anime series page (DESC order), scraped from the server-rendered episode list",
      "request": {
        "method": "GET",
        "url": "https://animotvslash.org/anime/%7Bslug%7D/",
        "headers": {
          "accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7",
          "accept-language": "en-US,en;q=0.9",
          "priority": "u=0, i",
          "sec-ch-ua": "\"Google Chrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\"",
          "sec-ch-ua-mobile": "?0",
          "sec-ch-ua-platform": "\"Linux\"",
          "sec-fetch-dest": "document",
          "sec-fetch-mode": "navigate",
          "sec-fetch-site": "none",
          "sec-fetch-user": "?1",
          "upgrade-insecure-requests": "1",
          "user-agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/153.0.0.0 Safari/537.36"
        }
      },
      "slots": [
        {
          "param": "slug",
          "at": [
            "path:1"
          ]
        }
      ],
      "volatile": [],
      "trigger": {
        "url": "https://animotvslash.org/anime/{slug}/"
      },
      "match": {
        "method": "GET",
        "host": "animotvslash.org",
        "path": "/anime/*/"
      },
      "response": {
        "format": "html",
        "contentType": "",
        "html": {
          "items": "ul#ts-ep-list li",
          "fields": {
            "url": "a@href",
            "num": ".epl-num",
            "title": ".epl-title",
            "date": ".epl-date"
          }
        }
      },
      "params": [
        {
          "name": "slug",
          "type": "string",
          "required": true,
          "example": "one-piece"
        }
      ],
      "readOnly": true,
      "minTier": 1,
      "learnedLoggedIn": false
    },
    {
      "name": "episode",
      "description": "Video servers of an episode page: label (e.g. 'Sub - ANIMO-P') plus base64-encoded iframe HTML in value (atob(value) -> iframe src; ANIMO-P src hash is base64 JSON with master/alt HLS+MP4 URLs, subs, fonts, skip markers, thumbnails)",
      "request": {
        "method": "GET",
        "url": "https://animotvslash.org/%7Bslug%7D/",
        "headers": {
          "accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7",
          "accept-language": "en-US,en;q=0.9",
          "priority": "u=0, i",
          "sec-ch-ua": "\"Google Chrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\"",
          "sec-ch-ua-mobile": "?0",
          "sec-ch-ua-platform": "\"Linux\"",
          "sec-fetch-dest": "document",
          "sec-fetch-mode": "navigate",
          "sec-fetch-site": "none",
          "sec-fetch-user": "?1",
          "upgrade-insecure-requests": "1",
          "user-agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/153.0.0.0 Safari/537.36"
        }
      },
      "slots": [
        {
          "param": "slug",
          "at": [
            "path:0"
          ]
        }
      ],
      "volatile": [],
      "trigger": {
        "url": "https://animotvslash.org/{slug}/"
      },
      "match": {
        "method": "GET",
        "host": "animotvslash.org",
        "path": "/*/"
      },
      "response": {
        "format": "html",
        "contentType": "",
        "html": {
          "items": "select.mirror option",
          "fields": {
            "label": "",
            "value": "@value",
            "index": "@data-index"
          }
        }
      },
      "params": [
        {
          "name": "slug",
          "type": "string",
          "required": true,
          "example": "reincarnated-as-a-sword-season-2-episode-4"
        }
      ],
      "readOnly": true,
      "minTier": 1,
      "learnedLoggedIn": false
    },
    {
      "name": "find-episode",
      "description": "Map series post ID + episode number -> episode post ID via wp-json animo/v1 (coverage is partial: many series return id=null; get the series ID from wp/v2/anime?slug=... or the search op)",
      "request": {
        "method": "GET",
        "url": "https://animotvslash.org/wp-json/animo/v1/find-episode?seri=%7Bseri%7D&ep=%7Bep%7D",
        "headers": {
          "accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7",
          "accept-language": "en-US,en;q=0.9",
          "priority": "u=0, i",
          "sec-ch-ua": "\"Google Chrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\"",
          "sec-ch-ua-mobile": "?0",
          "sec-ch-ua-platform": "\"Linux\"",
          "sec-fetch-dest": "document",
          "sec-fetch-mode": "navigate",
          "sec-fetch-site": "none",
          "sec-fetch-user": "?1",
          "upgrade-insecure-requests": "1",
          "user-agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/153.0.0.0 Safari/537.36"
        }
      },
      "slots": [
        {
          "param": "seri",
          "at": [
            "query:seri"
          ]
        },
        {
          "param": "ep",
          "at": [
            "query:ep"
          ]
        }
      ],
      "volatile": [],
      "trigger": {
        "url": "https://animotvslash.org/wp-json/animo/v1/find-episode?seri={seri}&ep={ep}"
      },
      "match": {
        "method": "GET",
        "host": "animotvslash.org",
        "path": "/wp-json/animo/v1/find-episode"
      },
      "response": {
        "format": "json",
        "contentType": "application/json; charset=UTF-8",
        "extract": "id",
        "pick": [
          "episodeId"
        ]
      },
      "params": [
        {
          "name": "seri",
          "type": "string",
          "required": true,
          "example": "589"
        },
        {
          "name": "ep",
          "type": "string",
          "required": true,
          "example": "1"
        }
      ],
      "readOnly": true,
      "minTier": 1,
      "learnedLoggedIn": false
    },
    {
      "name": "browse",
