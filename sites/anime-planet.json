{
  "name": "anime-planet",
  "baseUrl": "https://www.anime-planet.com",
  "operations": [
    {
      "name": "search",
      "request": {
        "method": "GET",
        "url": "https://www.anime-planet.com/manga/all?name=%7Bname%7D",
        "headers": {
          "accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7",
          "accept-language": "en-US,en;q=0.9",
          "priority": "u=0, i",
          "sec-ch-ua": "\"Google Chrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\"",
          "sec-ch-ua-mobile": "?0",
          "sec-ch-ua-platform": "\"Linux\"",
          "sec-fetch-dest": "document",
          "sec-fetch-mode": "navigate",
          "sec-fetch-site": "none",
          "sec-fetch-user": "?1",
          "upgrade-insecure-requests": "1",
          "user-agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/153.0.0.0 Safari/537.36"
        }
      },
      "slots": [
        {
          "param": "name",
          "at": [
            "query:name"
          ]
        }
      ],
      "volatile": [],
      "trigger": {
        "url": "https://www.anime-planet.com/manga/all?name={name}"
      },
      "match": {
        "method": "GET",
        "host": "www.anime-planet.com",
        "path": "/manga/all"
      },
      "response": {
        "format": "html",
        "contentType": "text/html; charset=UTF-8",
        "html": {
          "items": ".card",
          "fields": {
            "title": "img@alt",
            "url": "a@href",
            "img": "img@src",
            "imgLazy": "img@data-src"
          }
        }
      },
      "params": [
        {
          "name": "name",
          "type": "string",
          "required": true,
          "example": "kaiju"
        }
      ],
      "readOnly": true,
      "minTier": 1,
      "learnedLoggedIn": false
    },
    {
      "name": "entry-state",
      "request": {
        "method": "GET",
        "url": "https://www.anime-planet.com/manga/%7Bslug%7D",
        "headers": {
          "accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7",
          "accept-language": "en-US,en;q=0.9",
          "priority": "u=0, i",
          "sec-ch-ua": "\"Google Chrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\"",
          "sec-ch-ua-mobile": "?0",
          "sec-ch-ua-platform": "\"Linux\"",
          "sec-fetch-dest": "document",
          "sec-fetch-mode": "navigate",
          "sec-fetch-site": "none",
          "sec-fetch-user": "?1",
          "upgrade-insecure-requests": "1",
          "user-agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/153.0.0.0 Safari/537.36"
        }
      },
      "slots": [
        {
          "param": "slug",
          "at": [
            "path:1"
          ]
        }
      ],
      "volatile": [],
      "trigger": {
        "url": "https://www.anime-planet.com/manga/{slug}"
      },
      "match": {
        "method": "GET",
        "host": "www.anime-planet.com",
        "path": "/manga/*"
      },
      "response": {
        "format": "html",
        "contentType": "text/html; charset=UTF-8",
        "html": {
          "items": "form.myListBar",
          "fields": {
            "id": "@data-id",
            "status": "select.changeStatus option[selected]@value",
            "chapters": "select.chapters option[selected]@value",
            "totalChapters": "select.chapters@data-eps",
            "rating": ".rateme@name"
          }
        }
      },
      "params": [
        {
          "name": "slug",
          "type": "string",
          "required": true,
          "example": "kaiju-no-8"
        }
      ],
      "readOnly": true,
      "minTier": 1,
      "learnedLoggedIn": false
    },
    {
      "name": "getManga",
      "request": {
        "method": "GET",
        "url": "https://www.anime-planet.com/manga/%7Bslug%7D",
        "headers": {
          "accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7",
          "accept-language": "en-US,en;q=0.9",
          "priority": "u=0, i",
          "sec-ch-ua": "\"Google Chrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\"",
          "sec-ch-ua-mobile": "?0",
          "sec-ch-ua-platform": "\"Linux\"",
          "sec-fetch-dest": "document",
          "sec-fetch-mode": "navigate",
          "sec-fetch-site": "none",
          "sec-fetch-user": "?1",
          "upgrade-insecure-requests": "1",
          "user-agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/153.0.0.0 Safari/537.36"
        }
      },
      "slots": [
        {
          "param": "slug",
          "at": [
            "path:1"
          ]
        }
      ],
      "volatile": [],
      "trigger": {
        "url": "https://www.anime-planet.com/manga/{slug}"
      },
      "match": {
        "method": "GET",
        "host": "www.anime-planet.com",
        "path": "/manga/*"
      },
      "response": {
        "format": "html",
        "contentType": "text/html; charset=UTF-8",
        "html": {
          "items": "html",
          "fields": {
            "title": "h1",
            "description": "meta[name=description]@content",
            "ogTitle": "meta[property*=title]@content",
            "cover": "meta[property*=image]@content",
            "id": "form.myListBar@data-id",
            "totalChapters": "form.myListBar select.chapters@data-eps"
          }
        }
      },
      "params": [
        {
          "name": "slug",
          "type": "string",
          "required": true,
          "example": "kaiju-no-8"
        }
      ],
      "readOnly": true,
      "minTier": 1,
      "learnedLoggedIn": false
    }
  ]
}
